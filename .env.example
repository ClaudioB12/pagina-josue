# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio: ya está ignorado en .gitignore.
# En Vercel, estas variables se definen en Project Settings → Environment Variables.

# ─── Fase 1: landing ───────────────────────────────────────────────────────────

# URL pública del sitio, sin barra final. Se usa en la metadata (canónica y
# Open Graph), el sitemap, robots.txt y los datos estructurados.
# Si no se define, en Vercel se usa el dominio de producción del proyecto y en
# local http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Fase 3: funciones dinámicas (todavía no se usan) ──────────────────────────

# Conexión a MySQL (servicio gestionado externo).
# Formato: mysql://USUARIO:CLAVE@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=

# Secreto con el que Auth.js firma las sesiones. Genera uno con: npx auth secret
AUTH_SECRET=

# Clave de la API de Resend para enviar correos.
RESEND_API_KEY=

# Dirección que recibe el aviso de cada nueva solicitud de demo.
CORREO_AVISOS=

# Remitente de los correos. Debe pertenecer a un dominio verificado en Resend.
# Ejemplo: OchoaSoft <hola@tudominio.com>
CORREO_REMITENTE=
